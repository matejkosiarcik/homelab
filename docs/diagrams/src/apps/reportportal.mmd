---
title: ReportPortal
config:
    theme: dark
    flowchart:
        diagramPadding: 50
---

flowchart LR
    classDef cluster fill:#ffffff00,stroke:#aabbccff,stroke-width:3px,rx:8px,ry:8px;
    classDef node fill:#ffffff00,stroke:#aabbccff,stroke-width:2px,rx:5px,ry:5px;
    classDef dashed_border stroke-dasharray:10 6;
    classDef strong_border stroke-width:5px;

    subgraph app_wrapper["App"]
        inbound_interface(" ")
        apache_proxy("<div class='custom-node'><img src='../../../../icons/apache.png' /><p>Apache<br/>proxy</p></div>")
        apache_prometheus_exporter("<div class='custom-node'><img src='../../../../icons/apache-prometheus-exporter.png' /><p>Apache<br/>prometheus<br/>exporter</p></div>")
        certificator("<div class='custom-node'><img src='../../../../icons/certificator.png' /><p>Certificator</p></div>")
        favicons("<div class='custom-node'><img src='../../../../icons/picture.png' /><p>Favicons</p></div>")
        postgres("<div class='custom-node'><img src='../../../../icons/postgres.png' /><p>Postgres</p></div>")
        rabbitmq("<div class='custom-node'><img src='../../../../icons/rabbitmq.png' /><p>RabbitMQ</p></div>")
        opensearch("<div class='custom-node'><img src='../../../../icons/opensearch.png' /><p>Opensearch</p></div>")
        app_index("<div class='custom-node'><img src='../../../../icons/reportportal.png' /><p>ReportPortal<br/>Index</p></div>")
        class app_index strong_border;
        app_ui("<div class='custom-node'><img src='../../../../icons/reportportal.png' /><p>ReportPortal<br/>UI</p></div>")
        class app_ui strong_border;
        app_api("<div class='custom-node'><img src='../../../../icons/reportportal.png' /><p>ReportPortal<br/>API</p></div>")
        class app_api strong_border;
        app_uat("<div class='custom-node'><img src='../../../../icons/reportportal.png' /><p>ReportPortal<br/>UAT(Authorization)</p></div>")
        class app_uat strong_border;
        app_jobs("<div class='custom-node'><img src='../../../../icons/reportportal.png' /><p>ReportPortal<br/>Jobs</p></div>")
        class app_jobs strong_border;
        app_analyzer("<div class='custom-node'><img src='../../../../icons/reportportal.png' /><p>ReportPortal<br/>Analyzer</p></div>")
        class app_analyzer strong_border;
        app_migrations("<div class='custom-node'><img src='../../../../icons/reportportal-migrations.png' /><p>ReportPortal<br/>Migrations</p></div>")
        class app_migrations strong_border;

        %% app_index ~~~ app_ui & app_api & app_uat ~~~ app_jobs & app_analyzer & app_migrations

        postgres & rabbitmq & opensearch ~~~ app_analyzer & app_migrations

        inbound_interface -->|:80,443| apache_proxy
        apache_proxy -->|/:8080| app_index
        apache_proxy -->|/ui:8080| app_ui
        apache_proxy -->|/api:8585| app_api
        apache_proxy -->|/uat:9999| app_uat
        apache_proxy -->|/jobs:8686| app_jobs
        app_migrations -->|use| postgres
        app_api -->|use| postgres & rabbitmq
        app_uat -->|use| postgres & rabbitmq
        app_jobs -->|use| postgres & rabbitmq
        app_analyzer -->|use| opensearch & rabbitmq
        apache_proxy -.-|fs| certificator
        apache_prometheus_exporter -.->|/.apache/status| apache_proxy -->|/.apache/metrics| apache_prometheus_exporter
        apache_prometheus_exporter & app_index & app_ui & app_api & favicons ~~~ certificator
        apache_proxy -->|"/favicon.{ico,png}"| favicons -.->|use| app_ui
    end

    subgraph others_1["Others"]
        home_network("<div class='custom-node'><img src='../../../../icons/network.png' /><p>Home<br/>Network</p></div>")
        prometheus("<div class='custom-node'><img src='../../../../icons/prometheus.png' /><p>Prometheus</p></div>")
        gatus("<div class='custom-node'><img src='../../../../icons/gatus.png' /><p>Gatus</p></div>")
        playwright_tests("<div class='custom-node'><img src='../../../../icons/playwright.png' /><p>Playwright Tests</p></div>")

        home_network <--> inbound_interface
        prometheus -->|collect metrics| inbound_interface
        gatus -->|monitor| inbound_interface
        playwright_tests -->|send data| inbound_interface
    end

    subgraph others_2["Others"]
        certbot("<div class='custom-node'><img src='../../../../icons/lets-encrypt.png' /><p>Certbot</p></div>")
        healthchecks("<div class='custom-node'><img src='../../../../icons/healthchecks.png' /><p>Healthchecks</p></div>")

        certificator -->|report status| healthchecks
        certificator -.->|download certificate| certbot
    end

    others_1 ~~~ app_wrapper
    app_migrations & favicons ~~~ others_2
