---
title: Home Assistant
config:
    theme: dark
    flowchart:
        diagramPadding: 50
---

flowchart LR
    classDef cluster fill:#ffffff00,stroke:#aabbccff,stroke-width:3px,rx:8px,ry:8px;
    classDef node fill:#ffffff00,stroke:#aabbccff,stroke-width:2px,rx:5px,ry:5px;
    classDef dashed_border stroke-dasharray:10 6;
    classDef strong_border stroke-width:5px;

    subgraph app_wrapper["App"]
        inbound_interface(" ")
        apache_proxy("<div class='custom-node'><img src='../../../../icons/apache.png' /><p>Apache<br/>proxy</p></div>")
        apache_prometheus_exporter("<div class='custom-node'><img src='../../../../icons/apache-prometheus-exporter.png' /><p>Apache<br/>prometheus<br/>exporter</p></div>")
        certificator("<div class='custom-node'><img src='../../../../icons/certificator.png' /><p>Certificator</p></div>")
        favicons("<div class='custom-node'><img src='../../../../icons/picture.png' /><p>Favicons</p></div>")
        app("<div class='custom-node'><img src='../../../../icons/homeassistant.png' /><p>Home<br/>Assistant</p></div>")
        class app strong_border;
        script_backup("<div class='custom-node'><img src='../../../../icons/backup-script.png' /><p>Backup<br/>script<br/>(unused)</p></div>")

        inbound_interface -->|:80,443| apache_proxy -->|/*:8123| app
        apache_proxy -.-|fs| certificator
        apache_prometheus_exporter -.->|/.apache/status| apache_proxy -->|/.apache/metrics| apache_prometheus_exporter
        apache_proxy -->|"/favicon.{ico,png}"| favicons -.->|use| app
    end

    subgraph others_1["Others"]
        home_network("<div class='custom-node'><img src='../../../../icons/network.png' /><p>Home<br/>Network</p></div>")
        prometheus("<div class='custom-node'><img src='../../../../icons/prometheus.png' /><p>Prometheus</p></div>")
        gatus("<div class='custom-node'><img src='../../../../icons/gatus.png' /><p>Gatus</p></div>")

        home_network <--> inbound_interface
        prometheus -->|collect metrics| inbound_interface
        gatus -->|monitor| inbound_interface
    end

    subgraph others_2["Others"]
        healthchecks("<div class='custom-node'><img src='../../../../icons/healthchecks.png' /><p>Healthchecks</p></div>")
        certbot("<div class='custom-node'><img src='../../../../icons/lets-encrypt.png' /><p>Certbot</p></div>")
        s3_database("<div class='custom-node'><img src='../../../../icons/minio.png' /><p>MinIO</p></div>")
        smart_home("<div class='custom-node'><img src='../../../../icons/smart-home-devices.png' /><p>Smart<br/>Home<br/>Devices</p></div>")

        app ~~~ script_backup -.->|get backup| app
        app -->|control| smart_home
        certificator -->|report status| healthchecks
        certificator -->|download certificate| certbot
        script_backup -->|send_backup| s3_database
    end

    certificator & script_backup ~~~ others_2
