---
title: Lamp Controller
config:
    theme: dark
    flowchart:
        diagramPadding: 50
---

flowchart LR
    classDef cluster fill:#ffffff00,stroke:#aabbccff,stroke-width:3px,rx:8px,ry:8px;
    classDef node fill:#ffffff00,stroke:#aabbccff,stroke-width:2px,rx:5px,ry:5px;
    classDef dashed_border stroke-dasharray:10 6;
    classDef strong_border stroke-width:5px;

    subgraph app_wrapper["App"]
        inbound_interface(" ")
        lamp_controller("<div class='custom-node'><img src='../../../../icons/placeholder.png' /><p>Lamp controller</p></div>")
        class lamp_controller strong_border

        gpio_button("<div class='custom-node'><img src='../../../../icons/button.png' /><p>Button</p></div>")
        class gpio_button dashed_border
        gpio_lamp("<div class='custom-node'><img src='../../../../icons/lightbulb.png' /><p>Lamp</p></div>")
        class gpio_lamp dashed_border

        inbound_interface --> lamp_controller
        lamp_controller ~~~ gpio_button -->|GPIO 2| lamp_controller
        lamp_controller -->|GPIO 14| gpio_lamp
    end

    subgraph others_1["Others"]
        home_network("<div class='custom-node'><img src='../../../../icons/network.png' /><p>Home<br/>Network</p></div>")
        homeassistant("<div class='custom-node'><img src='../../../../icons/homeassistant.png' /><p>Home<br/>Assistant</p></div>")
    end

    home_network <--> inbound_interface
    homeassistant -.->|control| inbound_interface
