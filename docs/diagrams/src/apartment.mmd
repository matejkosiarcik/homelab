---
title: Apartment schema
config:
    theme: dark
    flowchart:
        diagramPadding: 50
---

flowchart LR
    classDef role fill:#ffffff00,stroke:#71869bff,stroke-width:2px,rx:8px,ry:8px;
    classDef no_border fill:transparent,stroke:transparent,stroke-width:0px;
    classDef planned fill:#ffffff00,stroke:#aabbccff,stroke-width:2px,stroke-dasharray:8 5,rx:5px,ry:5px;

    subgraph living_room["Living Room"]
        direction TB

        subgraph living_room__matej_desk["Living Room - Matej's Desk"]
            direction TB

            switch__unifi_usw_flex_25g_8port__living_room("<div class='custom-node'><img src='../../../../icons/switch.png' /><p>Switch<br>UniFi USW flex 2.5G 8-port</p></div>")
            server__raspberry_pi_4b_2gb("<div class='custom-node'><img src='../../../../icons/server-mini.png' /><p>Server<br>Raspberry Pi 4B 2GB</p></div>")
            server__raspberry_pi_4b_4gb("<div class='custom-node'><img src='../../../../icons/server-mini.png' /><p>Server<br>Raspberry Pi 4B 4GB</p></div>")
            notebook__matej_personal("<div class='custom-node'><img src='../../../../icons/notebook.png' /><p>Matej's Personal Notebook</p></div>")
            notebook__matej_work("<div class='custom-node'><img src='../../../../icons/notebook.png' /><p>Matej's Work Notebook</p></div>")

            switch__unifi_usw_flex_25g_8port__living_room --- server__raspberry_pi_4b_2gb & server__raspberry_pi_4b_4gb & notebook__matej_personal & notebook__matej_work
        end

        subgraph living_room__tv_closet["Living Room - Media Closet"]
            direction TB

            switch__unifi_usw_flex_25g_5port__living_room("<div class='custom-node'><img src='../../../../icons/switch.png' /><p>Switch<br>UniFi USW flex 2.5G 5-port</p></div>")
            tcl_tv("<div class='custom-node'><img src='../../../../icons/old-tv.png' /><p>TCL TV</p></div>")
            xiaomi_tv_box("<div class='custom-node'><img src='../../../../icons/old-tv.png' /><p>Xiaomi TV Box</p></div>")

            switch__unifi_usw_flex_25g_5port__living_room --- xiaomi_tv_box & tcl_tv
        end

        living_room__matej_desk ~~~ living_room__tv_closet
        switch__unifi_usw_flex_25g_8port__living_room --- switch__unifi_usw_flex_25g_5port__living_room
    end

    subgraph hallway["Hallway"]
        direction TB

        subgraph hallway__closet["Hallway - Closet"]
            direction TB

            isp_router("<div class='custom-node'><img src='../../../../icons/router.png' /><p>ISP Router</p></div>")
            router("<div class='custom-node'><img src='../../../../icons/router.png' /><p>My Router</p></div>")
            switch__unifi_usw_flex_25g_8port_hallway("<div class='custom-node'><img src='../../../../icons/switch.png' /><p>Switch<br>UniFi USW flex 2.5G 8-port</p></div>")
            server__odroid_h4_ultra("<div class='custom-node'><img src='../../../../icons/server-small.png' /><p>Server<br>Odroid H4 Ultra</p></div>")
            server__odroid_h3("<div class='custom-node'><img src='../../../../icons/server-small.png' /><p>Server<br>Odroid H3</p></div>")
            wifi_ap__unifi_u6_mesh("<div class='custom-node'><img src='../../../../icons/wifi-ap.png' /><p>WiFi AP<br/>UniFi U6 Mesh</p></div>")

            isp_router --- router --- switch__unifi_usw_flex_25g_8port_hallway --- server__odroid_h4_ultra & server__odroid_h3 & wifi_ap__unifi_u6_mesh
        end
    end

    internet("<div class='custom-node'><img src='../../../../icons/cloud.png' /><p>Internet</p></div>")
    phone__matej("<div class='custom-node'><img src='../../../../icons/phone.png' /><p>Matej's Phone</p></div>")
    phone__monika("<div class='custom-node'><img src='../../../../icons/phone.png' /><p>Monika's Phone</p></div>")

    subgraph bedroom["Bedroom"]
        direction TB

        subgraph bedroom__matej_nightstand["Bedroom - Matej's Nightstand"]
            direction TB

            placeholder_1(" ")
        end

        subgraph bedroom__monika_nightstand["Bedroom - Monika's Nightstand"]
            direction TB

            placeholder_2(" ")
        end

        subgraph bedroom__monika_desk["Bedroom - Monika's Desk"]
            direction TB

            switch__unifi_usw_flex_25g_5port__bedroom("<div class='custom-node'><img src='../../../../icons/switch.png' /><p>Switch<br>UniFi USW flex 2.5G 5-port</p></div>")
            notebook__monika_personal("<div class='custom-node'><img src='../../../../icons/notebook.png' /><p>Monika's Notebook</p></div>")

            switch__unifi_usw_flex_25g_5port__bedroom --- notebook__monika_personal
        end

        bedroom__matej_nightstand ~~~ bedroom__monika_nightstand ~~~ bedroom__monika_desk

        switch__unifi_usw_flex_25g_5port__bedroom --- placeholder_1 & placeholder_2
    end

    living_room ~~~ hallway ~~~ internet & bedroom
    isp_router --- internet
    switch__unifi_usw_flex_25g_8port_hallway === switch__unifi_usw_flex_25g_8port__living_room
    switch__unifi_usw_flex_25g_8port_hallway --- switch__unifi_usw_flex_25g_5port__bedroom
    switch__unifi_usw_flex_25g_8port_hallway x-.-x|"[Unused]"| switch__unifi_usw_flex_25g_8port__living_room & switch__unifi_usw_flex_25g_5port__bedroom
    wifi_ap__unifi_u6_mesh -.-|"Wifi"| phone__matej & phone__monika & notebook__matej_personal & notebook__matej_work & notebook__monika_personal
