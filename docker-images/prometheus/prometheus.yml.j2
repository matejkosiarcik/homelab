global:
  scrape_interval: 600s

scrape_configs:
{%- for app in apps %}
{%- if app.prometheus.enabled -%}
{%- for endpoint in app.prometheus.endpoints -%}

{%- if endpoint.path == "/.apache/metrics" %}
  {%- set endpoint_name_suffix = "proxy" %}
{%- elif endpoint.path.startswith("/") and endpoint.path.endswith("/metrics") and endpoint.path.count("/") >= 2 %}
  {%- set endpoint_name_suffix = endpoint.path.split("/")[1] %} # This extract name from "/<name>/metrics" or "/<name>/api/metrics"
{%- elif endpoint.path == "/metrics" %}
  {%- set endpoint_name_suffix = "app" %}
{%- elif endpoint.path == "/api/prometheus" and app.app_type == "homeassistant" %}
  {%- set endpoint_name_suffix = "app" %}
{%- elif endpoint.path == "/minio/v2/metrics/cluster" and app.app_type == "minio" %}
  {%- set endpoint_name_suffix = "app" %}
{%- else %}
  {%- set endpoint_name_suffix = "UNKNOWN" %}
  # ERROR: Unknown path: {{ endpoint.path -}}
{%- endif %}

  - job_name: {{ app.full_name_machine }}-{{ endpoint_name_suffix }}
    scheme: https
    metrics_path: {{ endpoint.path }}
    {%- if endpoint.auth.type == "basic" %}
    {%- if endpoint.path.startswith("/.apache/") %}
      {%- set endpoint_auth_default_user = "proxy-prometheus" %}
    {%- else %}
      {%- set endpoint_auth_default_user = "prometheus" %}
    {%- endif %}
    {%- set endpoint_auth_user = endpoint.auth.user | default(endpoint_auth_default_user, true) %}
    {%- if endpoint.path.startswith("/runwisp/") %}
      {%- set runwisp_prefix = "RUNWISP_" %}
    {%- else %}
      {%- set runwisp_prefix = "" %}
    {%- endif %}
    basic_auth:
      username: {{ endpoint_auth_user }}
      password: ${{ "{" }}{{ app.full_name_env }}__{{ runwisp_prefix }}{{ endpoint_auth_user | replace("-", "_") | upper() }}_PASSWORD{{ "}" }}
    {%- elif endpoint.auth.type == "bearer" %}
    authorization:
      credentials: Bearer ${{ "{" }}{{ app.full_name_env }}__PROMETHEUS_TOKEN{{ "}" }}
    {%- endif %}
    static_configs:
      - targets: [{{ app.domain }}]
{%- endfor %}
{%- endif %}
{%- endfor %}
