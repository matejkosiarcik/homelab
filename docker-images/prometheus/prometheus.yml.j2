global:
  scrape_interval: 600s

scrape_configs:
{%- for app in apps %}
{%- if app.prometheus.enabled -%}
{%- for endpoint in app.prometheus.endpoints -%}

{%- if endpoint.path == "/metrics" %}
  {%- set endpoint_name_suffix = "app" %}
{%- elif app.app_type == "homeassistant" and endpoint.path == "/api/prometheus" %}
  {%- set endpoint_name_suffix = "app" %}
{%- elif app.app_type == "minio" and endpoint.path == "/minio/v2/metrics/cluster" %}
  {%- set endpoint_name_suffix = "app" %}
{%- elif endpoint.path == "/.apache/metrics" %}
  {%- set endpoint_name_suffix = "proxy" %}
{%- elif endpoint.path.startswith("/") and endpoint.path.endswith("/metrics") and endpoint.path.count("/") >= 2 %}
  {#- This extracts the <name> from "/<name>/metrics" or "/<name>/api/metrics" #}
  {%- set endpoint_name_suffix = endpoint.path.split("/")[1] %}
{%- else %}
  {%- set endpoint_name_suffix = "UNKNOWN" %}
  # ERROR: Unknown path: {{ endpoint.path -}}
{%- endif %}

{%- set endpoint_auth_default_user = "prometheus" %}

{%- if endpoint.path.startswith("/.apache/") %}
  {%- set endpoint_secret_prefix = "proxy_" %}
{%- elif endpoint.path.startswith("/docker-sockguard/") or endpoint.path.startswith("/runwisp/") %}
  {%- set endpoint_name_suffix = endpoint.path.split("/")[1] | replace("-", "_") | replace(" ", "_") ~ "_" %}
{%- else %}
  {%- set endpoint_secret_prefix = "app_" %}
{%- endif %}

{%- set endpoint_auth_user = endpoint.auth.user | default(endpoint_auth_default_user, true) %}

  - job_name: {{ app.full_name_machine }}-{{ endpoint_name_suffix }}
    scheme: https
    metrics_path: {{ endpoint.path }}
    {%- if endpoint.auth.type == "basic" %}
    basic_auth:
      username: {{ endpoint_auth_user }}
      password: ${{ "{" }}{{ app.full_name_env }}__{{ endpoint_secret_prefix | upper() }}{{ endpoint_auth_user | replace("-", "_") | upper() }}_PASSWORD{{ "}" }}
    {%- elif endpoint.auth.type == "bearer" %}
    authorization:
      credentials: Bearer ${{ "{" }}{{ app.full_name_env }}__{{ endpoint_secret_prefix | upper() }}{{ endpoint_auth_user | replace("-", "_") | upper() }}_TOKEN{{ "}" }}
    {%- endif %}
    static_configs:
      - targets: [{{ app.domain }}]
{%- endfor %}
{%- endif %}
{%- endfor %}
