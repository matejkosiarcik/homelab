{%- for item in apache["upstream-url"] if item.env is not defined or item.env == build_env -%}
{%- if item.path == "/" %}
    ProxyPassReverse "{{ item.path }}" "{{ item.target }}/"
{%- elif item.path.endswith("/") %}
    ProxyPassReverse "{{ item.path }}" "{{ item.target }}/"
{%- else %}
    ProxyPassReverse "{{ item.path }}" "{{ item.target }}"
{%- endif %}
{% endfor -%}
